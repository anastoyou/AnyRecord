# Public client configuration. Never put a Supabase service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Leave blank until the hosted recording service is deployed and verified.
# Development defaults to localhost:8787; packaged builds require an explicit URL.
VITE_CLOUD_SHARE_ENDPOINT=

# Cloudinary OAuth & Neon PostgreSQL Backend Configuration (Server/Main Process Only)
# Never prefix these with VITE_ so they are never bundled into frontend code.
CLOUDINARY_DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require
CLOUDINARY_TOKEN_KEY=replace_with_32_byte_random_key
CLOUDINARY_CLIENT_ID=
CLOUDINARY_CLIENT_SECRET=

# External OAuth Providers (GitHub)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
